"LevelInfo"
{
	"background" "clear"
}

"Pause Menu"
{
	"active" false

	"Resume Button"
	{
		"class" "ui_button"
		"onclick" "game_resume"
		@include("button_sounds.txt")
	}

	"Settings Button"
	{
		"class" "ui_button"
		"onclick" "open \"Settings Menu\""
		@include("button_sounds.txt")
	}
}

@include("settings_overlay.lvl")